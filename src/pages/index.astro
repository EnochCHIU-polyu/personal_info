const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

/* duplicate marquee content for a seamless loop */
const mq = document.getElementById('mq');
mq.innerHTML += mq.innerHTML + mq.innerHTML + mq.innerHTML;

/* rotating hero word */
const words = ['smart contracts','intelligent systems','full-stack apps','interactive art','hardware bridges'];
const rot = document.getElementById('rot');
let wi = 0;
if (!reduce) {
  setInterval(() => {
    wi = (wi + 1) % words.length;
    rot.classList.remove('swap');
    rot.querySelector('span').textContent = words[wi];
    void rot.offsetWidth; /* restart animation */
    rot.classList.add('swap');
  }, 2400);
}

/* scroll reveals */
const io = new IntersectionObserver(entries => {
  entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
}, { threshold: 0.12 });
document.querySelectorAll('.reveal').forEach(el => io.observe(el));

/* cyclist rides down the route as you scroll */
const rider = document.getElementById('rider');
function ride() {
  const max = document.documentElement.scrollHeight - innerHeight;
  const p = max > 0 ? scrollY / max : 0;
  rider.style.top = (p * 100) + '%';
  rider.style.transform = 'translate(-50%,-50%) rotate(' + (Math.sin(p * 20) * 6) + 'deg)';
}
if (!reduce) { addEventListener('scroll', ride, { passive: true }); ride(); }
</script>
</body>
</html>